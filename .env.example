# Choix du moteur de base de données (optionnel).
# Non défini  → auto : SQLite si disponible (node:sqlite), sinon PGlite (Postgres embarqué).
# "sqlite"    → force node:sqlite (local, Node ≥ 24).
# "postgres"  → force Postgres (PGlite embarqué, ou DATABASE_URL si défini).
# NUTRIVAE_STORE=postgres

# Postgres hébergé (Neon, Supabase…). Si défini ET NUTRIVAE_STORE=postgres,
# l'application l'utilise et l'ensemence au premier démarrage.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Fichier SQLite persistant (sinon : en mémoire, ensemencé depuis le catalogue).
# NUTRIVAE_DB=db/nutrivae.db
